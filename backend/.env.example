APP_ENV=development
# auto: readable console in development, JSON in production. Override with console or json.
LOG_FORMAT=auto
# Windows only: set to your installed PostgreSQL bin directory to use system libpq.
POSTGRES_BIN=
DATABASE_URL=postgresql+psycopg://app:local-demo-only@localhost:5432/ecommerce
PROVIDER_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=
FRONTEND_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
ACTION_TTL_SECONDS=300
CHAT_TIMEOUT_SECONDS=30
PROVIDER_TIMEOUT_SECONDS=10
MAX_AGENT_MODEL_CALLS=4
MAX_AGENT_TOOL_CALLS=4
CHAT_RATE_LIMIT=10
AUTH_RATE_LIMIT=10
